# Speech Emotion Detection — .gitignore

# ─── Raw dataset (too large for git) ──────────────────────────────
data/raw/
data/features/
data/processed/

# ─── Trained model files ──────────────────────────────────────────
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt

# ─── Results and logs ─────────────────────────────────────────────
results/training.log

# ─── Python ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-log.txt
pip-delete-this-directory.txt

# ─── Virtual environments ─────────────────────────────────────────
venv/
env/
.venv/
.env/
ENV/

# ─── Jupyter notebooks checkpoints ───────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ─── IDE files ────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Temporary files ──────────────────────────────────────────────
*.tmp
*.temp
tmp/
temp/

# ─── Audio files (uploads) ────────────────────────────────────────
*.mp3
*.m4a
*.flac
# Note: Keep test WAV files if any are in tests/fixtures/

# ─── Environment variables ────────────────────────────────────────
.env
.env.local
.env.*.local

# ─── Coverage / test reports ──────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
